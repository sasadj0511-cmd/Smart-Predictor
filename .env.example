# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
FIREBASE_PROJECT_ID="gen-lang-client-0309639121"
# JSON service account stored as one secret value on Render. Never expose it as VITE_*.
FIREBASE_SERVICE_ACCOUNT_JSON=""
# Firebase UID of the only user allowed to control Telegram admin routes.
ADMIN_FIREBASE_UID=""
# Random 32+ character secret registered with Telegram setWebhook.
TELEGRAM_WEBHOOK_SECRET=""

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Your Telegram Bot Token from BotFather
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_CHAT_ID: Your personal Chat ID to receive notifications
TELEGRAM_CHAT_ID=""

# SPORTMONKS_API_TOKEN: Your Sportmonks API Token
SPORTMONKS_API_TOKEN=""

# PERPLEXITY_API_KEY: Your Perplexity AI API Key
PERPLEXITY_API_KEY=""

# === RENDER DEPLOYMENT ===
# For Render deployment, use render.yaml configuration
# Build: npm install && npm run build
# Start: npm start (uses tsx for TypeScript execution)
