{
  "entities": {
    "MatchPrediction": {
      "title": "MatchPrediction",
      "description": "A football match prediction generated by the AI.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "The unique Mozzart match ID."
        },
        "homeTeam": {
          "type": "string",
          "description": "The home team name."
        },
        "awayTeam": {
          "type": "string",
          "description": "The away team name."
        },
        "matchDate": {
          "type": "string",
          "description": "The date and time of the match in ISO format."
        },
        "analyzedAt": {
          "type": "string",
          "format": "date-time",
          "description": "When the match was analyzed."
        },
        "userId": {
          "type": "string",
          "description": "The ID of the user who ran the analysis."
        },
        "source": {
          "type": "string",
          "description": "The data source (Sportmonks or Perplexity)."
        },
        "sourceLine": {
          "type": "string",
          "description": "The specific league and match ID string."
        },
        "injuries": {
          "type": "string",
          "description": "List of injured and suspended players."
        },
        "weather": {
          "type": "string",
          "description": "Weather conditions at the match location."
        },
        "matchTime": {
          "type": "string",
          "description": "The scheduled time of the match."
        },
        "mainPrediction": {
          "type": "object",
          "properties": {
            "tip": { "type": "string" },
            "confidence": { "type": "number" },
            "reason": { "type": "string" }
          }
        },
        "overUnder": {
          "type": "object",
          "properties": {
            "tip": { "type": "string" },
            "confidence": { "type": "number" }
          }
        },
        "btts": {
          "type": "object",
          "properties": {
            "tip": { "type": "string" },
            "confidence": { "type": "number" }
          }
        },
        "totalGoals": { "type": "string" },
        "firstHalf": {
          "type": "object",
          "properties": {
            "tip": { "type": "string" },
            "confidence": { "type": "number" }
          }
        },
        "analysis": {
          "type": "string",
          "description": "Detailed AI analysis of the match."
        }
      },
      "required": [
        "id",
        "homeTeam",
        "awayTeam",
        "matchDate",
        "analyzedAt",
        "userId",
        "mainPrediction",
        "overUnder",
        "btts",
        "totalGoals",
        "firstHalf",
        "analysis"
      ]
    }
  },
  "firestore": {
    "predictions": {
      "path": "predictions/{predictionId}",
      "schema": {
        "$ref": "#/entities/MatchPrediction"
      },
      "description": "Stores the analyzed match predictions to prevent duplicate processing."
    }
  }
}